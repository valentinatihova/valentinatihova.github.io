---
import Layout from '../layouts/Layout.astro';
import { articles } from '../data/articles';
---

<Layout
  title="Page not found | Valentina Tihova"
  description="The page you're looking for doesn't exist."
  noindex={true}
>
  <div slot="field" class="mx-auto max-w-[1160px] px-4 sm:px-6">
    <header class="pt-8 pb-12 lg:pt-10 lg:pb-14">
      <p class="text-[15px] font-semibold text-stone-600">404</p>
      <h1 class="mt-3 text-[38px] leading-[1.06] sm:text-[52px] lg:text-[64px] lg:leading-[1.04]">Page not found</h1>
      <p class="mt-5 max-w-[34em] text-[19px] leading-[1.5] text-stone-600 sm:text-xl">No page at this address. It may have moved, or the article was retired.</p>
    </header>
  </div>

  <main class="mx-auto max-w-[1160px] px-4 py-12 sm:px-6">
    <h2 class="text-[28px] leading-[1.15] sm:text-[34px]">Try one of these</h2>
    <ul class="mt-5 space-y-3 text-[18px]">
      <li><a href="/" class="text-fixed underline">Home</a></li>
      {articles.map((a) => (
        <li><a href={`/article/${a.id}/`} class="text-fixed underline">{a.title}</a></li>
      ))}
    </ul>
  </main>
</Layout>
