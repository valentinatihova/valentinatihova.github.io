---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { MDXComponents } from '../../components/article/MDXComponents';
import ReadNext from '../../components/article/ReadNext.astro';
import SchemaDriftStory from '../../components/article/SchemaDriftStory.astro';
import { articles } from '../../data/articles';

const SITE_URL = 'https://valentinatihova.com';

export async function getStaticPaths() {
  const entries = await getCollection('articles');
  return articles.map((article) => {
    const entry = entries.find((e) => e.slug === article.id);
    // A typo in an id must fail the build, not ship an empty article.
    if (!entry) throw new Error(`No MDX file in src/content/articles for article "${article.id}"`);
    return { params: { slug: article.id }, props: { article, entry } };
  });
}

const { article, entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const articleUrl = `${SITE_URL}/article/${article.id}/`;
// Search results cut titles after about 60 characters, so add the name only when it fits.
const pageTitle = article.title.length <= 41 ? `${article.title} | Valentina Tihova` : article.title;
const ogImage = `${SITE_URL}/og/${article.id}.png`;

const formattedDate = new Date(article.date).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.summary,
  url: articleUrl,
  datePublished: article.date,
  dateModified: article.date,
  author: {
    '@type': 'Person',
    name: 'Valentina Tihova',
    url: SITE_URL,
    sameAs: [
      'https://www.linkedin.com/in/valentina-tihova/',
      'https://github.com/valentinatihova',
    ],
  },
  publisher: {
    '@type': 'Person',
    name: 'Valentina Tihova',
    url: SITE_URL,
  },
  image: ogImage,
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
};

---

<Layout
  title={pageTitle}
  description={article.summary}
  canonical={articleUrl}
  ogImage={ogImage}
  ogImageAlt={article.title}
  ogType="article"
  jsonLd={articleJsonLd}
>
  <div slot="field" class="mx-auto max-w-[1160px] px-4 sm:px-6">
    <header class="pt-8 pb-12 lg:pt-10 lg:pb-14">
      <h1 class="max-w-[17ch] text-[38px] leading-[1.06] sm:text-[52px] lg:text-[64px] lg:leading-[1.04]">{article.title}</h1>
      <p class="mt-5 max-w-[34em] text-[19px] leading-[1.5] text-stone-600 sm:text-xl">{article.summary}</p>
      <p class="mt-5 flex flex-wrap gap-x-5 gap-y-1.5 text-[15px] text-stone-600">
        <time datetime={article.date}>{formattedDate}</time>
        <span>{article.readTime}</span>
        {article.githubUrl && <a href={article.githubUrl} class="text-fixed underline">Code on GitHub</a>}
      </p>
      {article.caseStudyFrame && (
        <dl class="mt-8 grid max-w-3xl grid-cols-1 gap-x-6 gap-y-1 border-t border-rule pt-5 text-[16px] sm:grid-cols-[140px_1fr]">
          <dt class="text-stone-600">My role</dt><dd class="mb-2 sm:mb-0">{article.caseStudyFrame.role}</dd>
          <dt class="text-stone-600">Scope</dt><dd class="mb-2 sm:mb-0">{article.caseStudyFrame.scope}</dd>
          <dt class="text-stone-600">Why it matters</dt><dd>{article.caseStudyFrame.outcome}</dd>
        </dl>
      )}
      {article.hero === 'schema-drift' && <div class="mt-9"><SchemaDriftStory /></div>}
    </header>
  </div>

  <main class="mx-auto max-w-[1160px] px-4 sm:px-6">
    <div class="grid gap-12 py-12 sm:py-14 lg:grid-cols-[minmax(0,680px)_220px] lg:gap-20">
      <article class="article-prose min-w-0">
        <Content components={MDXComponents} />
      </article>

      {toc.length >= 2 && (
        <aside class="hidden lg:block" aria-label="Table of contents">
          <nav class="sticky top-6 max-h-[calc(100vh-3rem)] overflow-y-auto text-[15px]">
            <p class="mb-2.5 font-semibold">On this page</p>
            <ol class="border-l border-rule">
              {toc.map((h) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    class:list={[
                      '-ml-px block border-l-2 border-transparent py-1.5 pl-3.5 leading-snug text-stone-600 no-underline hover:border-stone-400 hover:text-stone-900',
                      h.depth === 3 && 'pl-6',
                    ]}
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )}
    </div>

    <ReadNext currentId={article.id} />
  </main>
</Layout>
