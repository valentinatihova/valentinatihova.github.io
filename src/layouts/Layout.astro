---
import '../index.css';
import SiteNav from '../components/layout/SiteNav.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  jsonLd?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description = "Valentina Tihova, data and AI analyst. I find where a product's data misleads people, and fix it. Now: Salesforce customer data platforms, made legible to data engineers.",
  canonical,
  ogImage = 'https://valentinatihova.com/og-image.png',
  ogImageAlt = 'Valentina Tihova — Data & AI Analyst',
  ogType = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const canonicalUrl = canonical ?? Astro.url.href;
const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {/* Production only: the dev server injects inline scripts. A meta CSP cannot set frame-ancestors. */}
    {import.meta.env.PROD && (
      <meta
        http-equiv="Content-Security-Policy"
        content="default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'"
      />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Valentina Tihova" href="/rss.xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Valentina Tihova" />
    <meta name="theme-color" content="#F2F4F1" />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow" />
    }
    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Valentina Tihova" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <!-- JSON-LD structured data -->
    {jsonLdArray.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <!-- Sitewide Person + WebSite schema -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Valentina Tihova",
      "jobTitle": "Data & AI Analyst",
      "url": "https://valentinatihova.com",
      "sameAs": [
        "https://www.linkedin.com/in/valentina-tihova/",
        "https://github.com/valentinatihova"
      ]
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Valentina Tihova",
      "url": "https://valentinatihova.com",
      "description": "Open-source tools and write-ups on schema drift, metadata and trustworthy numbers in Salesforce customer data platforms."
    }
    </script>
  </head>
  <body class="antialiased">
    {Astro.slots.has('field') ? (
      <div class="field">
        <SiteNav />
        <slot name="field" />
      </div>
    ) : (
      <SiteNav />
    )}
    <slot />
    <footer class="mt-24 border-t border-rule">
      <div class="mx-auto flex max-w-[1160px] flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 pt-7 pb-10 text-[15px] text-stone-600 sm:px-6">
        <span>Valentina Tihova, Valencia, Spain</span>
        <ul class="flex gap-5">
          <li><a href="mailto:valentina.tikhova1@gmail.com" class="text-fixed underline">Email</a></li>
          <li><a href="https://www.linkedin.com/in/valentina-tihova/" target="_blank" rel="noreferrer" class="text-fixed underline">LinkedIn</a></li>
          <li><a href="https://github.com/valentinatihova" target="_blank" rel="noreferrer" class="text-fixed underline">GitHub</a></li>
        </ul>
      </div>
    </footer>
    <!-- Cloudflare Web Analytics (cookieless), production builds only so local visits are not counted -->
    {import.meta.env.PROD && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "d17c303955fe40668112c368f715f162"}'></script>
    )}
  </body>
</html>
