---
import { fixes, LEDGER_UPDATED } from '../../data/projects';

// Backticks in the data mark inline code.
const withCode = (s: string) =>
  s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!).replace(/`([^`]+)`/g, '<code>$1</code>');
const updated = new Date(LEDGER_UPDATED).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<div class="bg-field px-5 py-2 sm:px-7">
  <div class="flex items-baseline justify-between gap-3 py-3">
    <h3 id="ledger-h" class="text-[16px] font-semibold">{fixes.length} fixes</h3>
    <span class="text-[16px] text-stone-600">Latest {updated}</span>
  </div>
  <ol>
    {fixes.map((fix) => (
      <li class="pt-4 pb-4">
        <div class="mb-1.5 flex items-baseline justify-between gap-3">
          <h3 class="font-sans text-[16px] font-semibold tracking-normal">{fix.product}</h3>
          <a
            href={fix.proof.url}
            class:list={['shrink-0 text-[16px] font-semibold underline', fix.status === 'review' ? 'text-review' : 'text-fixed']}
          >
            {fix.proof.label}
          </a>
        </div>
        <p class="ledger-line"><span aria-label="Before:" class="text-broke">−</span><span set:html={withCode(fix.before)} /></p>
        <p class="ledger-line"><span aria-label="After:" class="text-fixed">+</span><span set:html={withCode(fix.after)} /></p>
      </li>
    ))}
  </ol>
</div>

<style>
  .ledger-line {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    margin-top: 2px;
    padding: 2px 0;
    font-size: 16px;
    line-height: 1.45;
  }
  .ledger-line > span:first-child { font-weight: 600; }
  .ledger-line :global(code) { font-size: 0.88em; }
</style>
