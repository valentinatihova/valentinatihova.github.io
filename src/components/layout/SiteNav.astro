---
// Static header: every link is visible at every width, so there is no menu to open or trap focus in.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const items = [
  { href: '/#work', label: 'Work', active: path === '/' },
  { href: '/#writing', label: 'Writing', active: path.startsWith('/article/') },
  { href: '/resume/', label: 'Resume', active: path === '/resume' },
  { href: 'https://github.com/valentinatihova', label: 'GitHub', active: false },
];
---

<header class="relative z-10">
  <div class="mx-auto flex min-h-16 max-w-[1160px] flex-wrap items-center justify-between gap-x-6 gap-y-1 px-4 sm:px-6">
    <a href="/" class="font-display text-[22px] text-stone-900 no-underline">Valentina Tihova</a>
    <nav aria-label="Site">
      <ul class="flex gap-4 text-[15px] font-medium sm:gap-6">
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={item.active ? 'page' : undefined}
              class:list={[
                'inline-block py-2.5 text-stone-900 no-underline',
                item.active ? 'underline decoration-2 underline-offset-[6px]' : 'hover:underline hover:underline-offset-[6px]',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
