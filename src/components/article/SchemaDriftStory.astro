---
// Animated article header. Without JavaScript, or with reduced motion, it shows the
// final shot; the script adds autoplay (once it is on screen), controls and scaling.
import { CAPTIONS, SHOTS, renderShot } from './schemaDriftStory';

const last = SHOTS;
---

<figure class="sd not-prose mb-14" data-sd>
  <!-- Controls sit outside the scaled stage, so the buttons keep their 44px size on phones. -->
  <div class="sd-bar">
    <div role="group" aria-label="Shots" class="sd-segs">
      {CAPTIONS.map((caption, i) => (
        <button
          type="button"
          class="sd-seg"
          data-shot={i + 1}
          aria-label={`Go to shot ${i + 1}: ${caption}`}
          aria-current={i + 1 === last ? 'step' : 'false'}
        >
          <span class:list={['sd-seg-bar', i + 1 <= last && 'is-done']}></span>
        </button>
      ))}
    </div>
    <span class="sd-count" data-count>Shot {last} of {SHOTS}</span>
    <button type="button" class="sd-play" data-play>Replay</button>
  </div>
  <div class="sd-box" data-box>
    <div class="sd-stage">
      <p class="sd-caption" aria-live="polite" data-caption>{CAPTIONS[last - 1]}</p>
      <div class="sd-frame" data-frame set:html={renderShot(last)} />
    </div>
  </div>
  <figcaption class="mt-2.5 text-[15px] text-stone-600">
    A synthetic org, invented for this demo. Press Play to replay, or pick a shot.
  </figcaption>
</figure>

<script>
  import { CAPTIONS, DURATIONS, SHOTS, renderShot } from './schemaDriftStory';

  for (const root of document.querySelectorAll<HTMLElement>('[data-sd]')) {
    const box = root.querySelector<HTMLElement>('[data-box]')!;
    const frame = root.querySelector<HTMLElement>('[data-frame]')!;
    const caption = root.querySelector<HTMLElement>('[data-caption]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const play = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const segs = [...root.querySelectorAll<HTMLButtonElement>('[data-shot]')];
    let shot = SHOTS;
    let playing = false;
    let timer: number | undefined;

    // Scale the 960x540 stage to the box width, never above 1:1.
    new ResizeObserver(([entry]) => {
      box.style.setProperty('--sd-scale', String(Math.min(1, entry.contentRect.width / 960)));
    }).observe(box);

    const show = (n: number) => {
      shot = n;
      frame.innerHTML = renderShot(n);
      caption.textContent = CAPTIONS[n - 1];
      // Restart the caption fade on every shot.
      caption.style.animation = 'none';
      void caption.offsetWidth;
      caption.style.animation = '';
      count.textContent = `Shot ${n} of ${SHOTS}`;
      segs.forEach((seg, i) => {
        seg.setAttribute('aria-current', i + 1 === n ? 'step' : 'false');
        seg.firstElementChild!.classList.toggle('is-done', i + 1 <= n);
      });
      play.textContent = playing ? 'Pause' : n === SHOTS ? 'Replay' : 'Play';
    };
    const stop = () => {
      clearTimeout(timer);
      playing = false;
    };
    const start = (from: number) => {
      stop();
      playing = true;
      show(from);
      const step = () => {
        timer = window.setTimeout(() => {
          if (shot >= SHOTS) {
            playing = false;
            show(SHOTS);
            return;
          }
          show(shot + 1);
          step();
        }, DURATIONS[shot - 1]);
      };
      step();
    };

    play.addEventListener('click', () => {
      if (playing) {
        stop();
        show(shot);
      } else start(shot === SHOTS ? 1 : shot);
    });
    segs.forEach((seg, i) =>
      seg.addEventListener('click', () => {
        stop();
        show(i + 1);
      }),
    );

    // Autoplay once, when the figure first comes into view, unless the reader asked for less motion.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          start(1);
        }
      }, { threshold: 0.5 });
      io.observe(box);
    }
  }
</script>

<style is:global>
  .sd-box {
    position: relative;
    max-width: 960px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid #cfd8d3;
    border-radius: 12px;
    background: #f2f4f1;
    container-type: inline-size;
    /* Stepped fallback before the script measures the box; never wider than the box. */
    --sd-scale: 0.35;
  }
  @container (min-width: 384px) { .sd-stage { --sd-step: 0.4; } }
  @container (min-width: 480px) { .sd-stage { --sd-step: 0.5; } }
  @container (min-width: 576px) { .sd-stage { --sd-step: 0.6; } }
  @container (min-width: 672px) { .sd-stage { --sd-step: 0.7; } }
  @container (min-width: 768px) { .sd-stage { --sd-step: 0.8; } }
  @container (min-width: 864px) { .sd-stage { --sd-step: 0.9; } }
  @container (min-width: 958px) { .sd-stage { --sd-step: 1; } }
  .sd-stage {
    position: absolute;
    left: 0;
    top: 0;
    width: 960px;
    height: 540px;
    transform-origin: 0 0;
    transform: scale(var(--sd-step, var(--sd-scale)));
    box-sizing: border-box;
    padding: 28px 52px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: #1d2b33;
    font-family: var(--font-sans);
  }
  /* Once the script has measured the box, use the exact scale. */
  .sd-box[style*='--sd-scale'] .sd-stage { transform: scale(var(--sd-scale)); }
  .sd-stage p { margin: 0; }
  .sd-bar {
    max-width: 960px;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    color: #1d2b33;
    font-family: var(--font-sans);
    container-type: inline-size;
  }
  .sd-segs { display: flex; gap: 2px; }
  .sd-seg,
  .sd-play {
    cursor: pointer;
    font: inherit;
    color: inherit;
  }
  .sd-seg {
    all: unset;
    cursor: pointer;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }
  .sd-seg-bar { display: block; width: 36px; height: 4px; border-radius: 2px; background: #c3cfca; }
  .sd-seg-bar.is-done { background: #1d2b33; }
  .sd-count { font-size: 14px; color: #4f5f66; }
  @container (max-width: 400px) { .sd-count { display: none; } }
  .sd-play {
    margin-left: auto;
    min-height: 44px;
    min-width: 96px;
    padding: 0 16px;
    background: transparent;
    border: 1px solid #9db0a8;
    border-radius: 22px;
    font-weight: 600;
  }
  .sd-seg:focus-visible,
  .sd-play:focus-visible,
  .sd-frame a:focus-visible { outline: 3px solid #1d5fa0; outline-offset: 2px; }
  .sd-caption {
    font-family: var(--font-serif);
    font-size: 44px;
    line-height: 1.1;
    animation: sd-fade 0.35s ease-out both;
  }
  .sd-frame { display: contents; }
  @keyframes sd-fade { from { opacity: 0; } }
  @keyframes sd-strike { from { transform: scaleX(0); } }
  @keyframes sd-drop { from { opacity: 0; transform: translateY(-14px); } }
  @keyframes sd-pull { from { transform: scale(1.7); } }
  @keyframes sd-draw { from { transform: scaleX(0); } }
  @keyframes sd-red { from { background-color: #ffffff; border-color: #7e938b; } }
  @keyframes sd-stamp { from { opacity: 0; transform: rotate(-3deg) scale(1.35); } }
  @media (prefers-reduced-motion: reduce) {
    .sd-box * { animation: none !important; }
  }
</style>
