{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/",
        "http://localhost/article/data360-schema-drift-ci/",
        "http://localhost/article/sfmc-false-opens/"
      ],
      "numberOfRuns": 3,
      "settings": { "blockedUrlPatterns": ["*cloudflareinsights.com*"] }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 30000 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 700000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
